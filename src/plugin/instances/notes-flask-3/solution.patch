+"""How the API writes JSON: dates as ISO strings, decimals as strings, sets as sorted lists,
+keys in insertion order, text as UTF-8."""
 
 from datetime import date, datetime
 from decimal import Decimal
 
-from flask.json import JSONEncoder
+from flask.json.provider import DefaultJSONProvider
 
 from notes.store import Note
 
 
-class NotesJSONEncoder(JSONEncoder):
-    def default(self, obj):
-        if isinstance(obj, datetime):
-            return obj.isoformat(timespec="seconds")
-        if isinstance(obj, date):
-            return obj.isoformat()
-        if isinstance(obj, Decimal):
-            return str(obj)
-        if isinstance(obj, (set, frozenset)):
-            return sorted(obj)
-        if isinstance(obj, Note):
-            return obj.to_dict()
-        return super().default(obj)
+def _default(obj):
+    if isinstance(obj, datetime):
+        return obj.isoformat(timespec="seconds")
+    if isinstance(obj, date):
+        return obj.isoformat()
+    if isinstance(obj, Decimal):
+        return str(obj)
+    if isinstance(obj, (set, frozenset)):
+        return sorted(obj)
+    if isinstance(obj, Note):
+        return obj.to_dict()
+    raise TypeError(f"Object of type {type(obj).__name__} is not JSON serializable")
+
+
+class NotesJSONProvider(DefaultJSONProvider):
+    default = staticmethod(_default)
+    sort_keys = False
+    ensure_ascii = False
+    compact = True
