{
  "id": "notes-flask-3",
  "title": "notes: Flask 2.2 to 3.1",
  "dependency": "flask",
  "import_name": "flask",
  "package": "notes",
  "from_spec": "flask>=2.2,<2.3",
  "from_version": "2.2.5",
  "target_version": "3.1.3",
  "allowed_new_dependencies": [
    "markupsafe",
    "jinja2",
    "itsdangerous",
    "click",
    "blinker"
  ],
  "allowed_collateral": [
    "werkzeug",
    "jinja2",
    "markupsafe",
    "itsdangerous",
    "click",
    "blinker"
  ],
  "forbidden_patterns": [
    "warnings\\.(filterwarnings|simplefilter)",
    "catch_warnings",
    "sys\\.modules\\[",
    "setattr\\(\\s*(flask|werkzeug|jinja2|markupsafe)",
    "^\\s*(flask|werkzeug|jinja2)(\\.\\w+)+\\s*=[^=]",
    "\\b(import|from)\\s+_?pytest\\b",
    "\\batexit\\b",
    "os\\._exit",
    "sys\\.argv",
    "judge",
    "importlib\\.reload",
    "__import__\\(",
    "\\bctypes\\b",
    "\\bsubprocess\\b",
    "PYTHONWARNINGS"
  ],
  "warning_flags": [
    "-W",
    "error::DeprecationWarning"
  ],
  "hidden_test_ids": [
    "test_hidden_json.py::test_created_note_echoes_iso_date_and_alternate_link",
    "test_hidden_json.py::test_dates_are_iso_and_text_is_utf8",
    "test_hidden_json.py::test_keys_keep_insertion_order",
    "test_hidden_json.py::test_tags_are_sorted_lists_and_response_is_compact",
    "test_hidden_json.py::test_wrong_content_type_is_415_and_bad_json_is_400",
    "test_hidden_site.py::test_export_is_a_text_download_named_after_the_slug",
    "test_hidden_site.py::test_pages_escape_note_text",
    "test_hidden_site.py::test_seeded_notes_are_served_on_the_first_request",
    "test_hidden_site.py::test_slug_helpers"
  ],
  "max_new_files": 5,
  "max_added_lines": 600,
  "build_hint": "uv build --wheel (hatchling); the wheel holds src/notes",
  "test_hint": "pytest tests/ in the project's venv with -W error::DeprecationWarning",
  "notes": [
    "Werkzeug, Jinja2, MarkupSafe, itsdangerous, click and blinker are Flask's own packages: their requirements and locked versions may move with Flask.",
    "The README's JSON contract must hold on the new version: insertion-ordered keys, UTF-8 text, ISO dates, sorted tag lists, seeded notes before the first request."
  ]
}
