{
  "id": "ledger-sqlalchemy-2",
  "title": "ledger: SQLAlchemy 1.4 to 2.1",
  "dependency": "sqlalchemy",
  "import_name": "sqlalchemy",
  "package": "ledger",
  "from_spec": "sqlalchemy>=1.4.50,<1.5",
  "from_version": "1.4.54",
  "target_version": "2.1.4",
  "allowed_new_dependencies": [],
  "allowed_collateral": [],
  "forbidden_patterns": [
    "warnings\\.(filterwarnings|simplefilter)",
    "catch_warnings",
    "sys\\.modules\\[",
    "setattr\\(\\s*sqlalchemy",
    "^\\s*sqlalchemy(\\.\\w+)+\\s*=[^=]",
    "SQLALCHEMY_WARN_20",
    "SQLALCHEMY_SILENCE_UBER_WARNING",
    "\\b(import|from)\\s+_?pytest\\b",
    "\\batexit\\b",
    "os\\._exit",
    "sys\\.argv",
    "judge",
    "importlib\\.reload",
    "__import__\\(",
    "\\bctypes\\b",
    "\\bsubprocess\\b",
    "PYTHONWARNINGS"
  ],
  "warning_flags": [
    "-W",
    "error::DeprecationWarning"
  ],
  "hidden_test_ids": [
    "test_hidden_ledger.py::test_get_account_by_id_and_missing",
    "test_hidden_ledger.py::test_import_csv_text_parses_and_validates",
    "test_hidden_ledger.py::test_import_rows_commits_and_counts",
    "test_hidden_ledger.py::test_signed_totals_flip_credit_normal_kinds",
    "test_hidden_reports.py::test_category_breakdown_is_largest_first",
    "test_hidden_reports.py::test_monthly_totals_are_oldest_first",
    "test_hidden_reports.py::test_schema_helpers_reflect_the_tables",
    "test_hidden_reports.py::test_to_csv_has_a_header_and_iso_dates"
  ],
  "max_new_files": 5,
  "max_added_lines": 600,
  "build_hint": "uv build --wheel (hatchling); the wheel holds src/ledger",
  "test_hint": "pytest tests/ in the project's venv with -W error::DeprecationWarning; SQLAlchemy's legacy-API warnings count as failures",
  "notes": [
    "The package's behaviour must stay: imported rows are committed and visible to later queries; reports return plain dicts and lists."
  ]
}
